{
  "schema": "agentfem.documentation-entry",
  "schema_version": "1.0",
  "project": "AgentFEM",
  "version": "0.4.4",
  "maturity": "early-release",
  "description": "AI-native finite-element computing for humans and agents.",
  "documentation": "https://haoming-luo.github.io/agentfem/",
  "repository": "https://github.com/haoming-luo/agentfem",
  "package": "https://pypi.org/project/agentfem/",
  "installation": {
    "platforms": [
      "linux",
      "macos",
      "windows-wsl2"
    ],
    "tested_python": "3.11",
    "tested_dolfinx": "0.11",
    "recommended": "mamba create -n agentfem-env --override-channels -c conda-forge python=3.11 fenics-dolfinx=0.11 c-compiler cxx-compiler agentfem",
    "mainland_china": "mamba create -n agentfem-env --no-rc --override-channels -c https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge python=3.11 fenics-dolfinx=0.11 c-compiler cxx-compiler agentfem",
    "mirror_triggers": [
      "Use the mirror channel",
      "\u8d70\u955c\u50cf\u901a\u9053"
    ],
    "mirror_policy": "explicit-or-canonical-unreachable; single-source; no-location-inference",
    "health_check": "agentfem doctor --json",
    "onboarding": {
      "schema_version": 1,
      "mode": "agent-assisted",
      "requires_repository_checkout": false,
      "detect": {
        "platform": "Inspect host OS and current shell; Windows uses WSL2. Reuse working Linux/WSL environments.",
        "channel": "Use the user's requested or recorded mirror choice; do not infer location from IP, language or VPN.",
        "unknown": "Ask only for the missing choice; do not guess installed platform state from a blocked probe."
      },
      "routes": {
        "windows-wsl2": {
          "guide": "windows_agent_installation/",
          "sequence": [
            "inspect",
            "wsl_platform",
            "ubuntu",
            "ordinary_user",
            "environment",
            "first_solve"
          ],
          "platform_only_command": "wsl --install --no-distribution --web-download",
          "platform_command_requires": "Missing platform, approved elevation, supported WSL options; not for healthy existing WSL.",
          "mirror_distribution": "Verified TUNA Ubuntu image import; do not depend on GitHub distribution metadata.",
          "existing_environment": "Reuse; no automatic overwrite, unregister, conversion or package upgrade."
        },
        "linux": {
          "guide": "getting_started/",
          "sequence": [
            "inspect",
            "environment",
            "first_solve"
          ]
        },
        "macos": {
          "guide": "getting_started/",
          "sequence": [
            "inspect",
            "environment",
            "first_solve"
          ]
        }
      },
      "failure_policy": {
        "automatic_attempts_per_stage": 1,
        "on_failure": "Stop this stage, retain its exact error, show one manual action; continue after readiness is verified.",
        "retry_requires": "Changed readiness, source or explicit user direction; never repeat a blocked command unchanged.",
        "no_policy_bypass": true,
        "no_global_security_or_proxy_changes": true
      },
      "handoffs": {
        "permission": "Approve this specific operation in your agent, or run the displayed command in your own terminal.",
        "elevation": "Open Terminal (Administrator), run the displayed platform command, and restart only if requested.",
        "restart": "Save your work and restart. Continue from the installed state; do not reinstall.",
        "download": "Show the failing source and the verified manual download/import route; do not repeat the same download.",
        "account": "Use authorised non-root preparation for a new import; enter Store/bundle credentials privately if prompted."
      },
      "progress": {
        "format": "stage: status \u2014 next action",
        "max_user_actions_at_once": 1
      },
      "remember": [
        "selected_channel",
        "distribution",
        "ordinary_user",
        "environment_path",
        "installed_version",
        "last_successful_stage"
      ],
      "never_record": [
        "passwords",
        "tokens"
      ],
      "completion": {
        "checks": [
          "doctor",
          "workspace_protection_on_wsl",
          "init",
          "check",
          "run",
          "verify"
        ],
        "summary": [
          "installed_version",
          "environment",
          "first_solve_status",
          "result_path",
          "numerical_check_with_units_where_applicable"
        ],
        "not_sufficient": [
          "download_finished",
          "platform_ready",
          "import_success",
          "doctor_alone"
        ]
      }
    }
  },
  "human_entrypoints": {
    "start": "get_started/",
    "guides": "guide/",
    "examples": "examples/",
    "reference": "reference/"
  },
  "agent_entrypoints": {
    "guide": "agents/",
    "llms_txt": "llms.txt",
    "knowledge_catalog": "https://raw.githubusercontent.com/haoming-luo/agentfem/main/src/agentfem/knowledge/catalog.json",
    "skill": "agents/skill/"
  },
  "commands": {
    "environment_check": "agentfem doctor --json",
    "workspace_check": "agentfem workspace --json",
    "capabilities": "agentfem capabilities --json",
    "project_check": "agentfem check --json",
    "run": "agentfem run --json",
    "mpi_run": "agentfem mpi-run -n 2 -- python case.py",
    "inspect": "agentfem inspect --json",
    "show_latest": "agentfem show latest --json",
    "compare_results": "agentfem compare REFERENCE CANDIDATE --quantity NAME --atol 0 --json",
    "runs": "agentfem runs --json",
    "mesh_inspect": "agentfem inspect-mesh model.msh --json",
    "abaqus_inspect": "agentfem inspect-abaqus model.inp --json",
    "abaqus_user_material_inspect": "agentfem inspect-user-material material.for --json",
    "abaqus_migrate": "agentfem migrate-abaqus model.inp ./project --json",
    "abaqus_lower": "agentfem lower-abaqus ./project --reviewed-by REVIEWER --unit-system SI --json",
    "verify": "agentfem verify --json",
    "telemetry_status": "agentfem telemetry status --json",
    "telemetry_route": "agentfem telemetry route auto --json",
    "diagnose": "agentfem diagnose --json",
    "community_support": "agentfem support --json",
    "assist": "agentfem assist --json",
    "feedback_archive": "agentfem feedback --json"
  },

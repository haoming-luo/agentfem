include README.md
include LICENSE
include NOTICE
include CITATION.cff
include CONTRIBUTING.md
include INSTALL.md
include WORKFLOW.md
include CONCEPTS.md
include AGENT_GUIDE.md
include pyproject.toml
include environment.yml
include logo/AgentFEM_logo.png
include logo/AgentFEM_logo_transparent.png

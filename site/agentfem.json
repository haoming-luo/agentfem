{
  "schema": "agentfem.documentation-entry",
  "schema_version": "1.0",
  "project": "AgentFEM",
  "version": "0.3.1",
  "maturity": "early-release",
  "description": "AI-native finite-element computing for humans and agents.",
  "documentation": "https://haoming-luo.github.io/agentfem/",
  "repository": "https://github.com/haoming-luo/agentfem",
  "package": "https://pypi.org/project/agentfem/",
  "installation": {
    "platforms": [
      "linux",
      "macos",
      "windows-wsl2"
    ],
    "tested_python": "3.11",
    "tested_dolfinx": "0.11",
    "recommended": "mamba create -n agentfem-env --override-channels -c conda-forge python=3.11 fenics-dolfinx=0.11 agentfem",
    "mainland_china": "mamba create -n agentfem-env --no-rc --override-channels -c https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge python=3.11 fenics-dolfinx=0.11 agentfem",
    "health_check": "agentfem doctor --json"
  },
  "human_entrypoints": {
    "start": "get_started/",
    "guides": "guide/",
    "examples": "examples/",
    "reference": "reference/"
  },
  "agent_entrypoints": {
    "guide": "agents/",
    "llms_txt": "llms.txt",
    "knowledge_catalog": "https://raw.githubusercontent.com/haoming-luo/agentfem/main/src/agentfem/knowledge/catalog.json",
    "skill": "agents/skill/"
  },
  "commands": {
    "environment_check": "agentfem doctor --json",
    "workspace_check": "agentfem workspace --json",
    "capabilities": "agentfem capabilities --json",
    "project_check": "agentfem check --json",
    "run": "agentfem run --json",
    "mpi_run": "agentfem mpi-run -n 2 -- python case.py",
    "inspect": "agentfem inspect --json",
    "abaqus_inspect": "agentfem inspect-abaqus model.inp --json",
    "abaqus_user_material_inspect": "agentfem inspect-user-material material.for --json",
    "abaqus_migrate": "agentfem migrate-abaqus model.inp ./project --json",
    "abaqus_lower": "agentfem lower-abaqus ./project --reviewed-by REVIEWER --unit-system SI --json",
    "verify": "agentfem verify --json",
    "telemetry_status": "agentfem telemetry status --json",
    "diagnose": "agentfem diagnose --json",
    "assist": "agentfem assist --json",
    "feedback_archive": "agentfem feedback --json"
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfem.org/schema/benchmark-card-0.1.0.json",
  "title": "AgentFEM Benchmark Card",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "title",
    "status",
    "purpose",
    "physics",
    "execution",
    "observables",
    "acceptance",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "agentfem.benchmark-card"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "physics": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object"
    },
    "observables": {
      "type": "array",
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1
    },
    "limitations": {
      "type": "array"
    }
  },
  "additionalProperties": false
}

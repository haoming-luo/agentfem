{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfem.org/schema/scientific-function-card-0.1.0.json",
  "title": "AgentFEM Scientific Function Card",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "title",
    "kind",
    "status",
    "summary",
    "public_api",
    "implementation",
    "science",
    "usage",
    "verification",
    "references",
    "related_cards"
  ],
  "properties": {
    "schema": {
      "const": "agentfem.scientific-function-card"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^agentfem\\.[a-z0-9][a-z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "analysis_step",
        "constraint",
        "data_asset",
        "learned_model",
        "material",
        "operator",
        "workflow"
      ]
    },
    "status": {
      "enum": [
        "supported",
        "experimental",
        "contract_only",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "public_api": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "science": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "references": {
      "type": "array",
      "minItems": 1
    },
    "related_cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
